# Rust 构建产物
/target/
**/*.rs.bk

# 构建好的二进制与安装包（请通过 GitHub Releases 分发）
/release/*.exe
/release/*.zip
/dist/*.exe
/dist/*.zip
/installer/*.exe

# 系统杂项
Thumbs.db
Desktop.ini
.DS_Store

# MSIX 成品与签名证书（证书绝不入库！）
msix/*.msix
msix/*.pfx
msix/*.cer
*.appx

# 编辑器 / IDE
.vscode/
.idea/
*.swp

# 打包载荷：由 tools/pack-msix.ps1 从 target/release 复制，不入库
# （曾因把旧 exe 提交进库，导致商店包里的 exe 落后于源码/是 console 子系统）
msix/layout/*.exe

# Python 工具产物
__pycache__/

# AI 助手会话状态（非项目内容）
.mimosa/
